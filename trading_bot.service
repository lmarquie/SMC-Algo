[Unit]
Description=FVG Trading Bot
After=network.target

[Service]
Type=simple
User=lucasmarquie
WorkingDirectory=/Users/lucasmarquie/Desktop/SMC Algo
Environment=PATH=/Users/lucasmarquie/Desktop/SMC Algo/.venv/bin
ExecStart=/Users/lucasmarquie/Desktop/SMC Algo/.venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target 